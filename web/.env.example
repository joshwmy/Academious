# Copy to .env.local for development. Never commit .env.local.
#
# WARNING: every VITE_* variable is inlined into the JavaScript bundle at build
# time and is therefore PUBLIC. It is visible to anyone who opens the site.
# Never put a secret, API key, database URL or credential here. The public
# Academious API needs none: it is unauthenticated by design.

# Base URL of the Academious API, no trailing slash.
VITE_API_BASE_URL=http://localhost:8000
