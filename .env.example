# Copy to .env and fill in. Never commit .env.
# All values below are safe placeholders, not real credentials.

ACADEMIOUS_ENV=development
ACADEMIOUS_LOG_LEVEL=INFO
ACADEMIOUS_LOG_FORMAT=json

# --- Database -------------------------------------------------------------
# Read by docker-compose.yml to initialise the database and to build the URL the
# containers use. Compose refuses to start if it is unset, so there is no path
# where a default password reaches a public host. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=replace-me-before-first-run

# Used when running the application outside Compose - tests, alembic from the
# host, a local uvicorn. Inside Compose this value is overridden with the `db`
# service hostname.
ACADEMIOUS_DATABASE_URL=postgresql+psycopg://academious:replace-me-before-first-run@localhost:5432/academious

# --- Contact identity -----------------------------------------------------
# Sent in the User-Agent of every outbound scholarly API request.
# Several sources (NCBI, arXiv, Crossref, Unpaywall) require a reachable
# address and will rate-limit or ban anonymous traffic.
ACADEMIOUS_CONTACT_EMAIL=you@example.com

# --- Source credentials ---------------------------------------------------
# OpenAlex has required a free API key since 2026-02-13.
# Without one you get 100 credits/day, which is demo-only.
# Register: https://openalex.org/
ACADEMIOUS_OPENALEX_API_KEY=

# --- Ingestion scope ------------------------------------------------------
# OpenAlex topic/field filters for the two approved launch domains.
ACADEMIOUS_OPENALEX_FILTERS=primary_topic.domain.id:1|primary_topic.field.id:17
ACADEMIOUS_ARXIV_SETS=cs,stat
ACADEMIOUS_BIORXIV_SERVERS=biorxiv,medrxiv
# `;`-separated Europe PMC query expressions. The default is the open-access
# subset; Europe PMC's terms prohibit bulk download of anything else.
ACADEMIOUS_EUROPEPMC_QUERIES=OPEN_ACCESS:Y

# How far back a fresh install harvests on first run.
ACADEMIOUS_INITIAL_BACKFILL_DAYS=7

# --- Retraction Watch -----------------------------------------------------
ACADEMIOUS_RETRACTIONWATCH_URL=https://api.labs.crossref.org/data/retractionwatch

# --- Embeddings and retrieval (Phase 2) -----------------------------------
# Which stored vectors the read path uses. Changing this switches retrieval to a
# different model or preprocessing version. See docs/embeddings.md.
ACADEMIOUS_EMBEDDING_PROFILE=specter2-proximity@v1

# Inference batch size, and how many torch threads to use (0 = let torch decide).
# Pin threads below the core count when embedding shares a machine with the API.
ACADEMIOUS_EMBEDDING_BATCH_SIZE=16
ACADEMIOUS_EMBEDDING_TORCH_THREADS=0

# Papers per queued job. Bounds how much work one crash can cost.
ACADEMIOUS_EMBEDDING_JOB_BATCH_SIZE=32

# Where HuggingFace caches the ~440 MB of SPECTER2 weights. Empty = HF default.
ACADEMIOUS_EMBEDDING_CACHE_DIR=

# How long a job may sit in `running` before a worker is presumed dead.
ACADEMIOUS_JOB_STALE_AFTER_MINUTES=30

ACADEMIOUS_RETRIEVAL_DEFAULT_LIMIT=20

# --- Public API surface (Phase 2 public read API) --------------------------
# Which retrieval method the public /search uses. Not a query parameter.
ACADEMIOUS_RETRIEVAL_DEFAULT_METHOD=semantic

# Browser origins allowed to call the API. EMPTY MEANS NONE, which is correct
# until a frontend is deployed. The Vite dev server runs on port 5173, so local
# frontend development needs this set; production names the real origin only,
# never a wildcard.
ACADEMIOUS_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Host header allowlist. Empty disables the check (development).
ACADEMIOUS_ALLOWED_HOSTS=

# How many trusted proxies sit in front of the app. 0 means the socket peer is
# the client, which is the safe default. Behind Caddy in production, set 1.
ACADEMIOUS_TRUSTED_PROXY_COUNT=0

# --- Deployment: Caddy and the public hostname ----------------------------
# Read by docker-compose.prod.yml and substituted into the Caddyfile. Only the
# production overlay needs these; local development never starts Caddy.
#
# The permanent API hostname. Its A record points at the VPS.
API_DOMAIN=api.academious.org
# Where Let's Encrypt sends expiry warnings if renewal ever stops working.
ACME_EMAIL=you@example.com

# --- Production values for the settings above ------------------------------
# Not a second set of variables - the same names, with the values production
# needs. Listed together because they are wrong by default and each has to be
# changed deliberately when the API stops being a development server.
#
#   ACADEMIOUS_ENV=production
#   ACADEMIOUS_TRUSTED_PROXY_COUNT=1        # exactly one proxy: Caddy (SEC-004)
#   ACADEMIOUS_CORS_ALLOWED_ORIGINS=https://academious.org
#   ACADEMIOUS_ALLOWED_HOSTS=api.academious.org
#
# TRUSTED_PROXY_COUNT is the one to get right. At 0 every request appears to
# come from Caddy, so the whole world shares one rate-limit bucket. Above 1, a
# client can spoof X-Forwarded-For and mint itself a fresh budget.
